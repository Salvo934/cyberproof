# Copia questo file in .env.local e inserisci i valori del tuo progetto Supabase
# (Project Settings → API Keys). Usa SOLO la chiave publishable (o la legacy anon):
# la service role key non deve mai finire nel frontend.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
